ARG PYTHON_IMAGE=python:3.14.4-slim
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/docker/requirements-model.txt /tmp/requirements-model.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements-model.txt

RUN useradd --create-home --uid 10001 app

COPY artifacts/serving/candidate-001-explained/ /app/model/
RUN chmod -R a+rX /app/model

USER app

EXPOSE 5001

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=3 \
    CMD ["python", "-c", "from urllib.request import urlopen; urlopen('http://127.0.0.1:5001/ping', timeout=4)"]

CMD ["mlflow", "models", "serve", "--model-uri", "/app/model", "--host", "0.0.0.0", "--port", "5001", "--env-manager", "local", "--workers", "1"]
