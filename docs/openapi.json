{
  "openapi": "3.1.0",
  "info": {
    "title": "AIOpsDesk API",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/model-info": {
      "get": {
        "summary": "Model Info",
        "operationId": "model_info_v1_model_info_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/predict": {
      "post": {
        "summary": "Predict",
        "operationId": "predict_v1_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PredictionResponse": {
        "properties": {
          "prediction_id": {
            "type": "string",
            "title": "Prediction Id"
          },
          "result": {
            "$ref": "#/components/schemas/PredictionResult"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prediction_id",
          "result",
          "model_version",
          "policy_version",
          "created_at",
          "warnings"
        ],
        "title": "PredictionResponse"
      },
      "PredictionResult": {
        "properties": {
          "category": {
            "type": "string",
            "title": "Category"
          },
          "category_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Category Score"
          },
          "priority": {
            "type": "string",
            "title": "Priority"
          },
          "priority_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Priority Score"
          },
          "team": {
            "type": "string",
            "title": "Team"
          },
          "needs_review": {
            "type": "boolean",
            "title": "Needs Review"
          },
          "review_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Review Reasons"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "category",
          "category_score",
          "priority",
          "priority_score",
          "team",
          "needs_review",
          "review_reasons"
        ],
        "title": "PredictionResult"
      },
      "TicketInput": {
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Subject"
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subject",
          "description"
        ],
        "title": "TicketInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
