  "components": {
    "schemas": {
      "CancelInput": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "CancelInput"
      },
      "ClaimInput": {
        "properties": {
          "worker_token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 32,
            "format": "password",
            "title": "Worker Token",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "worker_token"
        ],
        "title": "ClaimInput"
      },
      "FeedbackInput": {
        "properties": {
          "prediction_id": {
            "type": "string",
            "format": "uuid",
            "title": "Prediction Id"
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "Software",
                  "Account",
                  "Network",
                  "Security"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "priority": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "Medium",
                  "High"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason"
          },
          "label_source": {
            "type": "string",
            "enum": [
              "operator_review",
              "synthetic_demo"
            ],
            "title": "Label Source",
            "default": "operator_review"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prediction_id",
          "reason"
        ],
        "title": "FeedbackInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobFinish": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed",
              "cancelled",
              "interrupted"
            ],
            "title": "Status"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "stage_failed",
                  "stage_timeout",
                  "worker_interrupted",
                  "worker_connection_lost",
                  "quality_gate_failed"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "summary": {
            "additionalProperties": true,
